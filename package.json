{
  "name": "flecha",
  "productName": "Flecha",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "An Arc-style browser built on a Chromium fork.",
  "scripts": {
    "shell:build": "node chromium/shell/build.mjs",
    "shell:watch": "node chromium/shell/build.mjs --watch",
    "shell:typecheck": "tsc -p chromium/shell",
    "host:build": "node chromium/native-host/build.mjs",
    "host:typecheck": "tsc -p chromium/native-host",
    "typecheck": "tsc -p chromium/shell && tsc -p chromium/native-host"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "sucrase": "^3.35.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "esbuild": "^0.28.2",
    "zod": "^4.6.7"
  }
}
