{
  "manifest_version": 3,
  "name": "Flecha",
  "description": "Flecha's sidebar, Spaces and commands.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "158",
  "incognito": "split",
  "permissions": ["tabs", "cookies", "storage", "unlimitedStorage", "sidePanel", "history", "topSites", "favicon", "clipboardWrite", "flechaPrivate", "nativeMessaging", "debugger", "downloads", "downloads.open", "downloads.ui", "browsingData", "contentSettings", "alarms", "scripting", "userScripts", "webNavigation", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidebar.html" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": { "default_title": "Flecha" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["consoleHook.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["consoleBridge.js"], "run_at": "document_start" }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "easylist", "enabled": true, "path": "rules/easylist.json" },
      { "id": "easyprivacy", "enabled": true, "path": "rules/easyprivacy.json" }
    ]
  },
  "commands": {
    "flecha-open-location": { "description": "Open the location field (sent by the browser for Cmd+L)" }
  }
}
