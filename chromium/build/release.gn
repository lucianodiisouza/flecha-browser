# Release settings for macOS and Windows. Local macOS and hosted release builds
# fetch the PGO profiles pinned by the Chromium checkout.
is_debug = false
is_component_build = false
is_official_build = true
chrome_pgo_phase = 2
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
target_cpu = "arm64"

# Public builds omit H.264 and AAC because they require patent licences.
proprietary_codecs = false
use_remoteexec = false

# Our patches shouldn't fail a 3-6 hour build over a warning.
treat_warnings_as_errors = false
v8_enable_builtins_gearbox = false
v8_enable_runtime_call_stats = false

# Keep PDF viewing and extensions while omitting annotation, Drive, hosted
# Chrome Apps and WebXR support.
enable_pdf_ink2 = false
enable_pdf_save_to_drive = false
enable_hosted_apps = false
enable_vr = false
enable_openxr = false

# build-release.sh stages the shell for the framework's Resources (patch 0050).
flecha_shell_dir = "//flecha/shell"

# fetch-sparkle.sh fetches the official Sparkle updater (patches 0040 and 0053).
# Its public key comes from `generate_keys -p`. make-appcast.sh uses the
# corresponding EdDSA key in the release signer's login Keychain.
flecha_sparkle_framework = "//flecha/Sparkle.framework"
flecha_sparkle_feed_url = "https://flecha.dev/appcast.xml"
flecha_sparkle_public_key = "AHjs14q8ghu3og63BEFxU5uOlOYTcb7GDOSI7+R6j9s="
