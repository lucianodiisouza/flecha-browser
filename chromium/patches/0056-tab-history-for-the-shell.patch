+ExtensionFunction::ResponseAction FlechaPrivateGetTabHistoryFunction::Run() {
+  auto params = flecha_private::GetTabHistory::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  content::NavigationController& controller = contents->GetController();
+  flecha_private::TabHistory history;
+  history.can_go_back = controller.CanGoBack();
+  history.can_go_forward = controller.CanGoForward();
+  return RespondNow(WithArguments(history.ToValue()));
+}
