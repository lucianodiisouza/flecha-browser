+ExtensionFunction::ResponseAction FlechaPrivateSetMenusFunction::Run() {
+  auto params = flecha_private::SetMenus::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::vector<FlechaMenu> menus;
+  for (const flecha_private::Menu& menu : params->menus) {
+    FlechaMenu& out = menus.emplace_back();
+    out.title = menu.title;
+    for (const flecha_private::MenuItem& item : menu.items) {
+      FlechaMenuItem& entry = out.items.emplace_back();
+      entry.label = item.text.value_or("");
+      entry.command = item.command.value_or("");
+      if (item.accelerator) {
+        entry.accelerator = ParseFlechaAccelerator(*item.accelerator);
+      }
+      entry.checked = item.checked.value_or(false);
+      entry.enabled = item.enabled.value_or(true);
+    }
+  }
+  SetFlechaMenus(menus);
   return RespondNow(NoArguments());
 }
 
+ExtensionFunction::ResponseAction FlechaPrivateSetAlwaysOnTopFunction::Run() {
+  auto params = flecha_private::SetAlwaysOnTop::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  FlechaFrameHost* host =
+      params->window_id ? HostForWindow(*params->window_id, browser_context())
+                        : FlechaFrameHost::Main(Profile::FromBrowserContext(
+                                                    browser_context())
+                                                    ->GetOriginalProfile());
+  BrowserWindowInterface* browser =
+      host ? host->GetBrowserWindowInterface() : nullptr;
+  if (!browser || !browser->GetWindow()) {
+    return RespondNow(Error(kNoWindowError, "(stay on top)"));
+  }
+  browser->GetWindow()->SetZOrderLevel(params->on_top
+                                           ? ui::ZOrderLevel::kFloatingWindow
+                                           : ui::ZOrderLevel::kNormal);
+  return RespondNow(NoArguments());
+}
