+// One entry of a Flecha menu (chrome.flechaPrivate.setMenus()). An empty
+// label is a separator.
+struct FlechaMenuItem {
+  std::string label;
+  // Sent to the shell as onShortcut(command, windowId) for the window in
+  // front.
+  std::string command;
+  // Shown beside the item; the key itself works through setShortcuts().
+  std::optional<ui::Accelerator> accelerator;
+  bool checked = false;
+  bool enabled = true;
+};
+
+struct FlechaMenu {
+  std::string title;
+  std::vector<FlechaMenuItem> items;
+};
+
+#if BUILDFLAG(IS_MAC)
+// Puts these menus in the menu bar, before the Window menu, in place of the
+// ones set before. A menu titled like one already there ("Window") adds its
+// items at the top of that one instead.
+void SetFlechaMenus(const std::vector<FlechaMenu>& menus);
+#else
+// Other platforms have no menu bar of their own.
+inline void SetFlechaMenus(const std::vector<FlechaMenu>& menus) {}
+#endif
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_FLECHA_PRIVATE_FLECHA_MENUS_H_
