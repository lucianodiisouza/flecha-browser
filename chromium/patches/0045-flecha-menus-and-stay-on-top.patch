+
+// The tag of the items setMenus() was told are disabled.
+constexpr NSInteger kFlechaDisabledItemTag = -0xf1ec;
+
+// The Flecha window a menu command is for: the one in front, else the last
+// active window that isn't a Flechinha.
+FlechaFrameHost* FlechaHostInFront() {
+  NSWindow* front = NSApp.keyWindow ?: NSApp.mainWindow;
+  FlechaFrameHost* last_active = nullptr;
+  for (FlechaFrameHost* host : FlechaFrameHost::All()) {
+    BrowserWindowInterface* browser = host->GetBrowserWindowInterface();
+    if (front && browser && browser->GetWindow() &&
+        browser->GetWindow()->GetNativeWindow().GetNativeNSWindow() == front) {
+      return host;
+    }
+    if (!last_active && host->IsActiveWindow() && !host->IsFlechinha()) {
+      last_active = host;
+    }
+  }
+  return last_active;
+}
+
+}  // namespace
+
+// Runs Flecha's menu items: each sends its command to the shell, as a
+// keyboard shortcut would.
+@interface FlechaMenuTarget : NSObject <NSMenuItemValidation>
+@end
+
+@implementation FlechaMenuTarget
+
+- (void)runFlechaCommand:(NSMenuItem*)item {
+  if (![item.representedObject isKindOfClass:[NSString class]]) {
+    return;
+  }
+  NSString* command = item.representedObject;
+  FlechaFrameHost* host = FlechaHostInFront();
+  if (!command.length || !host) {
+    return;
+  }
+  base::ListValue args;
+  args.Append(base::SysNSStringToUTF8(command));
+  args.Append(host->GetWindowId());
+  DispatchFlechaShellEvent(
+      Profile::FromBrowserContext(host->GetBrowserContext()),
+      "flechaPrivate.onShortcut", std::move(args));
+}
+
+- (BOOL)validateMenuItem:(NSMenuItem*)item {
+  return item.tag != kFlechaDisabledItemTag && FlechaHostInFront() != nullptr;
+}
+
+@end
+
+void SetFlechaMenus(const std::vector<FlechaMenu>& menus) {
+  static FlechaMenuTarget* target = [[FlechaMenuTarget alloc] init];
+  // What the last call put in the menu bar, to take out again.
+  static NSMutableArray<NSMenuItem*>* added = [[NSMutableArray alloc] init];
+
+  NSMenu* main_menu = NSApp.mainMenu;
+  if (!main_menu) {
+    return;
+  }
+  for (NSMenuItem* item in added) {
+    [item.menu removeItem:item];
+  }
+  [added removeAllObjects];
+
+  auto make_item = [](const FlechaMenuItem& entry) -> NSMenuItem* {
+    if (entry.label.empty()) {
+      return [NSMenuItem separatorItem];
+    }
+    NSMenuItem* item =
+        [[NSMenuItem alloc] initWithTitle:base::SysUTF8ToNSString(entry.label)
+                                   action:@selector(runFlechaCommand:)
+                            keyEquivalent:@""];
+    item.target = target;
+    item.representedObject = base::SysUTF8ToNSString(entry.command);
+    item.state =
+        entry.checked ? NSControlStateValueOn : NSControlStateValueOff;
+    if (!entry.enabled) {
+      item.tag = kFlechaDisabledItemTag;
+    }
+    if (entry.accelerator) {
+      KeyEquivalentAndModifierMask* keys =
+          ui::GetKeyEquivalentAndModifierMaskFromAccelerator(
+              *entry.accelerator);
+      item.keyEquivalent = keys.keyEquivalent;
+      item.keyEquivalentModifierMask = keys.modifierMask;
+    }
+    return item;
+  };
+
+  const NSInteger window_menu =
+      NSApp.windowsMenu ? [main_menu indexOfItemWithSubmenu:NSApp.windowsMenu]
+                        : -1;
+  NSInteger insert_at = window_menu >= 0 ? window_menu : main_menu.numberOfItems;
+  for (const FlechaMenu& menu : menus) {
+    NSString* title = base::SysUTF8ToNSString(menu.title);
+    NSMenuItem* existing = [main_menu itemWithTitle:title];
+    if (existing.submenu && !existing.hidden) {
+      NSInteger at = 0;
+      for (const FlechaMenuItem& entry : menu.items) {
+        NSMenuItem* item = make_item(entry);
+        [existing.submenu insertItem:item atIndex:at++];
+        [added addObject:item];
+      }
+      NSMenuItem* separator = [NSMenuItem separatorItem];
+      [existing.submenu insertItem:separator atIndex:at];
+      [added addObject:separator];
+      continue;
+    }
+    NSMenu* submenu = [[NSMenu alloc] initWithTitle:title];
+    for (const FlechaMenuItem& entry : menu.items) {
+      [submenu addItem:make_item(entry)];
+    }
+    NSMenuItem* top = [[NSMenuItem alloc] initWithTitle:title
+                                                 action:nil
+                                          keyEquivalent:@""];
+    top.submenu = submenu;
+    [main_menu insertItem:top atIndex:insert_at++];
+    [added addObject:top];
+  }
+}
