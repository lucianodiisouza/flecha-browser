+void MultiContentsView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::View::OnBoundsChanged(previous_bounds);
+  if (width() == previous_bounds.width() || !IsInSplitView() ||
+      !IsFlechaFlatSplit()) {
+    return;
+  }
+  auto* browser = browser_view_->browser();
+  Profile* const profile = browser->GetProfile();
+  if (profile->IsOffTheRecord()) {
+    return;
+  }
+  base::ListValue args;
+  args.Append(browser->GetSessionID().id());
+  DispatchFlechaShellEvent(profile,
+                           "flechaPrivate.onSplitAreaResized", std::move(args));
