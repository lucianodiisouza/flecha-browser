+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/flecha_window_close.h"
+
+#import <AppKit/AppKit.h>
+#import <CoreGraphics/CoreGraphics.h>
+
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// The app whose window is in front of the others on `screen`, Flecha's own
+// aside, or Finder for a bare desktop.
+NSRunningApplication* FlechaAppBehind(NSScreen* screen) {
+  const CGRect screen_bounds = CGDisplayBounds(
+      [screen.deviceDescription[@"NSScreenNumber"] unsignedIntValue]);
+  const pid_t own_pid = NSProcessInfo.processInfo.processIdentifier;
+  // On screen means on the active desktops, front to back.
+  NSArray* windows = CFBridgingRelease(CGWindowListCopyWindowInfo(
+      kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+      kCGNullWindowID));
+  for (NSDictionary* info in windows) {
+    const pid_t pid = [info[(__bridge id)kCGWindowOwnerPID] intValue];
+    CGRect bounds = CGRectZero;
+    if (pid == own_pid || [info[(__bridge id)kCGWindowLayer] intValue] != 0 ||
+        [info[(__bridge id)kCGWindowAlpha] doubleValue] <= 0 ||
+        !CGRectMakeWithDictionaryRepresentation(
+            (__bridge CFDictionaryRef)info[(__bridge id)kCGWindowBounds],
+            &bounds) ||
+        !CGRectIntersectsRect(bounds, screen_bounds)) {
+      continue;
+    }
+    NSRunningApplication* app =
+        [NSRunningApplication runningApplicationWithProcessIdentifier:pid];
+    if (app.activationPolicy == NSApplicationActivationPolicyRegular) {
+      return app;
+    }
+  }
+  return [NSRunningApplication
+             runningApplicationsWithBundleIdentifier:@"com.apple.finder"]
+      .firstObject;
+}
+
+// Closing Flecha's only window on a desktop (Space) leaves Flecha active with
+// nothing to show there, and macOS goes to the desktop of its other windows
+// as soon as one of them becomes key. The app that was behind the window
+// takes over instead, as if Flecha had been hidden.
+void LeaveFlechaForAppBehind(NSWindow* closing) {
+  if (!NSApp.active || !closing.onActiveSpace) {
+    return;
+  }
+  // Flecha went on to another of its windows (Open in Flecha): follow it.
+  NSWindow* key = NSApp.keyWindow;
+  if (key && key != closing) {
+    return;
+  }
+  for (NSWindow* window in NSApp.windows) {
+    if (window != closing && window.visible && window.onActiveSpace &&
+        !window.parentWindow && window.canBecomeMainWindow) {
+      return;
+    }
+  }
+  NSRunningApplication* app = FlechaAppBehind(closing.screen);
+  if (!app) {
+    return;
+  }
+  if (@available(macOS 14.0, *)) {
+    [NSApp yieldActivationToApplication:app];
+  }
+  [app activateWithOptions:0];
+}
+
+}  // namespace
+
+void LeaveFlechaWhenLastWindowOnDesktopCloses(views::Widget* widget) {
+  if (!widget) {
+    return;
+  }
+  __block id observer = [NSNotificationCenter.defaultCenter
+      addObserverForName:NSWindowWillCloseNotification
+                  object:widget->GetNativeWindow().GetNativeNSWindow()
+                   queue:nil
+              usingBlock:^(NSNotification* notification) {
+                [NSNotificationCenter.defaultCenter removeObserver:observer];
+                observer = nil;
+                LeaveFlechaForAppBehind(notification.object);
+              }];
+}
