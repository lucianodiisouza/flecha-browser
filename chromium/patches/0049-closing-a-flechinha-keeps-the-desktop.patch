+
+// When `widget`'s window closes as the last Flecha window on its desktop, the
+// app behind it becomes the active one. A no-op off macOS.
+#if BUILDFLAG(IS_MAC)
+void LeaveFlechaWhenLastWindowOnDesktopCloses(views::Widget* widget);
