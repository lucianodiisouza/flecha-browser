+// Flecha: a shortcut with Option, for the key Option was held on. Chromium
+// names a key by the character it types, and Option changes that character:
+// on US International, Option-N types "~", so Cmd-Option-N reads as the
+// grave accent key and Flecha's Cmd-Option-N never matched (while the main
+// menu took the "~" for Cmd-Shift-grave). Flecha's shortcuts name the key
+// itself, so this asks again with the character typed without Option.
+- (BOOL)flechaShortcutForBaseKey:(NSEvent*)event window:(NSWindow*)window {
+  if (!(event.modifierFlags & NSEventModifierFlagOption)) {
+    return NO;
+  }
+  NSString* unmodified = event.charactersIgnoringModifiers;
+  if (unmodified.length == 0 ||
+      [unmodified isEqualToString:event.characters]) {
+    return NO;
+  }
+  const ui::KeyboardCode key =
+      ui::KeyboardCodeFromCharCode([unmodified characterAtIndex:0]);
+  if (key == ui::VKEY_UNKNOWN) {
+    return NO;
+  }
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForNativeWindow(gfx::NativeWindow(window));
+  if (!browser_view) {
+    return NO;
+  }
+  input::NativeWebKeyboardEvent keyboard_event(
+      (base::apple::OwnedNSEvent(event)));
+  const ui::Accelerator typed =
+      ui::GetAcceleratorFromNativeWebKeyboardEvent(keyboard_event);
+  BrowserWindowInterface* browser = browser_view->browser();
+  return DispatchFlechaShortcut(browser->GetProfile(),
+                                ui::Accelerator(key, typed.modifiers()),
+                                browser->GetSessionID().id());
+}
