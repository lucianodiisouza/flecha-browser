+// Flecha: the frame page's drag areas (-webkit-app-region: drag) move the
+// window, and a press there never reaches the page: the content view's hit
+// test hands it to the window. So an area could move the window or be
+// clicked, not both. With flechaDragAreasClickable, a press that is released
+// where it began, with the window where it was, goes to the page after all,
+// as a click; one that moves is the window move it always was. That lets a
+// control (a Flechinha's address) be a place to grab the window by.
+- (void)sendEvent:(NSEvent*)event {
+  if (!_flechaDragAreasClickable) {
+    _flechaPress = nil;
+    [super sendEvent:event];
+    return;
+  }
+  const NSEventType type = event.type;
+  if (type == NSEventTypeLeftMouseDown) {
+    _flechaPress = nil;
+    // The first press only (a double click zooms the window, as on a title
+    // bar), and not a control-click (a right click). A nil hit test is the
+    // content view's answer for a drag area.
+    if (event.clickCount == 1 &&
+        !(event.modifierFlags & NSEventModifierFlagControl) &&
+        [self.contentView hitTest:event.locationInWindow] == nil) {
+      _flechaPress = event;
+      _flechaPressFrame = self.frame;
+      _flechaPressAt = NSEvent.mouseLocation;
+      [super sendEvent:event];
+      // The window move follows the mouse until the button is let go and
+      // may take that event with it.
+      if (_flechaPress && !(NSEvent.pressedMouseButtons & 1)) {
+        [self finishFlechaPress];
+      }
+      return;
+    }
+  } else if (type == NSEventTypeLeftMouseUp && _flechaPress) {
+    [self finishFlechaPress];
+  }
+  [super sendEvent:event];
+}
+
+// Flecha: the button is up again after a press in a drag area. Unmoved, the
+// press and a release go to the view under it.
+- (void)finishFlechaPress {
+  NSEvent* press = _flechaPress;
+  _flechaPress = nil;
+  // As far as a click may wander.
+  constexpr CGFloat kSlop = 3;
+  const NSPoint at = NSEvent.mouseLocation;
+  if (!NSEqualRects(self.frame, _flechaPressFrame) ||
+      std::abs(at.x - _flechaPressAt.x) > kSlop ||
+      std::abs(at.y - _flechaPressAt.y) > kSlop) {
+    return;
+  }
+  // The content view's hit test answers nil for a drag area, and the page's
+  // view asks it before it takes a mouse event; both see through for now.
+  base::AutoReset<BOOL> click(&_flechaClickInDragArea, YES);
+  NSView* target = [self.contentView hitTest:press.locationInWindow];
+  if (!target) {
+    return;
+  }
+  NSEvent* release =
+      [NSEvent mouseEventWithType:NSEventTypeLeftMouseUp
+                         location:press.locationInWindow
+                    modifierFlags:press.modifierFlags
+                        timestamp:NSProcessInfo.processInfo.systemUptime
+                     windowNumber:self.windowNumber
+                          context:nil
+                      eventNumber:press.eventNumber
+                       clickCount:1
+                         pressure:0];
+  [target mouseDown:press];
+  [target mouseUp:release];
+}
