 #import <Security/Security.h>
 
+#include "base/apple/foundation_util.h"
 #include "base/apple/osstatus_logging.h"
 #include "base/apple/scoped_cftyperef.h"
 #include "base/base64.h"
 #include "base/containers/span.h"
+#include "base/files/file_util.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/no_destructor.h"
 #include "base/rand_util.h"
@@ -35,8 +37,30 @@
 const char kDefaultServiceName[] = "Chrome Safe Storage";
 const char kDefaultAccountName[] = "Chrome";
 #else
-const char kDefaultServiceName[] = "Chromium Safe Storage";
-const char kDefaultAccountName[] = "Chromium";
+// Flecha: its own item. "Chromium Safe Storage" belongs to whichever Chromium
+// build made it first (Chromium, Helium, other forks), so macOS asked people
+// to let Flecha into another app's key on its very first launch.
+const char kDefaultServiceName[] = "Flecha Safe Storage";
+const char kDefaultAccountName[] = "Flecha";
+#endif
+
+#if !BUILDFLAG(GOOGLE_CHROME_BRANDING)
+// The item Flecha 0.1.3 and earlier used.
+const char kLegacyServiceName[] = "Chromium Safe Storage";
+const char kLegacyAccountName[] = "Chromium";
+
+// Whether the Flecha profile already holds data encrypted with the legacy key.
+// A fresh profile has no cookie database yet, so it never touches (or prompts
+// for) the legacy item.
+bool HasLegacyEncryptedData() {
+  const base::FilePath profile = base::apple::GetUserLibraryPath()
+                                     .Append("Application Support")
+                                     .Append("Flecha Browser")
+                                     .Append("Default");
+  return base::PathExists(profile.Append("Network").Append("Cookies")) ||
+         base::PathExists(profile.Append("Cookies")) ||
+         base::PathExists(profile.Append("Login Data"));
+}
 #endif
 
 // These values are persisted to logs. Entries should not be renumbered and
@@ -105,6 +129,24 @@
 
   if (password.error() == errSecItemNotFound) {
     uma_result = FindGenericPasswordResult::kPasswordNotFound;
+#if !BUILDFLAG(GOOGLE_CHROME_BRANDING)
+    // Flecha: an existing profile carries its key over from the legacy item,
+    // once, so its cookies and saved passwords still decrypt.
+    if (HasLegacyEncryptedData()) {
+      auto legacy =
+          keychain_->FindGenericPassword(kLegacyServiceName, kLegacyAccountName);
+      if (legacy.has_value()) {
+        std::string legacy_password(base::as_string_view(*legacy));
+        OSStatus error = keychain_->AddGenericPassword(
+            GetServiceName(), GetAccountName(),
+            base::as_byte_span(legacy_password));
+        if (error != noErr) {
+          OSSTATUS_DLOG(ERROR, error) << "Keychain migration failed";
+        }
+        return legacy_password;
+      }
+    }
+#endif
     return AddRandomPasswordToKeychain(*keychain_, GetServiceName(),
                                        GetAccountName());
   }
