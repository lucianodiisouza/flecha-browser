+// A link from another app activates Flecha. When all of Flecha's windows are
+// on other desktops (Spaces), macOS answers the new window becoming key by
+// switching to the desktop of the others and taking the new window along,
+// away from the app the link was clicked in. A window that moves to the
+// active Space keeps the desktop where it is. Only while it opens: afterwards
+// the window belongs to that desktop like any other, and going back to it
+// switches desktops as usual.
+void KeepFlechaWindowOnActiveDesktop(views::Widget* widget) {
+  if (!widget) {
+    return;
+  }
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  if (window.collectionBehavior &
+      (NSWindowCollectionBehaviorMoveToActiveSpace |
+       NSWindowCollectionBehaviorCanJoinAllSpaces)) {
+    return;
+  }
+  window.collectionBehavior |= NSWindowCollectionBehaviorMoveToActiveSpace;
+  // The switch macOS would make comes after the activation, not with it.
+  constexpr int64_t kSettledMs = 1000;
+  __weak NSWindow* weak_window = window;
+  dispatch_after(
+      dispatch_time(DISPATCH_TIME_NOW, kSettledMs * NSEC_PER_MSEC),
+      dispatch_get_main_queue(), ^{
+        weak_window.collectionBehavior &=
+            ~NSWindowCollectionBehaviorMoveToActiveSpace;
+      });
+}
