+ExtensionFunction::ResponseAction FlechaPrivateNavigateFunction::Run() {
+  auto params = flecha_private::Navigate::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  const GURL url(params->url);
+  // A javascript: URL would run in the page; the omnibox doesn't take them
+  // either.
+  if (!url.is_valid() || url.SchemeIs(url::kJavaScriptScheme)) {
+    return RespondNow(Error("Flecha can't navigate to *", params->url));
+  }
+  content::NavigationController::LoadURLParams load_params(url);
+  load_params.transition_type = ui::PageTransitionFromInt(
+      ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+  if (!contents->GetController().LoadURLWithParams(load_params)) {
+    return RespondNow(Error("Flecha couldn't navigate to *", params->url));
+  }
+  return RespondNow(NoArguments());
 }
 
