+
+ExtensionFunction::ResponseAction
+FlechaPrivateSetTitlebarColorFunction::Run() {
+  auto params = flecha_private::SetTitlebarColor::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::optional<SkColor> color = ParseColor(params->color);
+  if (!color) {
+    return RespondNow(Error(kBadColorError));
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(browser_context())->GetOriginalProfile();
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    if (browser->GetSessionID().id() == params->window_id &&
+        browser->GetProfile()->GetOriginalProfile() == profile &&
+        browser->GetWindow()) {
+      SetFlechaTitlebarColor(browser->GetWindow()->GetNativeWindow(), *color);
+      return RespondNow(NoArguments());
+    }
+  }
+  return RespondNow(Error(kNoWindowError, "(title bar)"));
 }
 
