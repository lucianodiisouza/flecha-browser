+++ b/chrome/browser/extensions/api/flecha_private/flecha_titlebar_mac.mm
@@ -0,0 +1,21 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/flecha_private/flecha_titlebar.h"
+
+#import <AppKit/AppKit.h>
+
+#include "skia/ext/skia_utils_mac.h"
+
+void SetFlechaTitlebarColor(gfx::NativeWindow native_window, SkColor color) {
+  NSWindow* window = native_window.GetNativeNSWindow();
+  if (!window) {
+    return;
+  }
+  // A transparent title bar shows the window's own background, and macOS
+  // draws the title and the window controls over it as usual.
+  window.titlebarAppearsTransparent = YES;
+  window.titlebarSeparatorStyle = NSTitlebarSeparatorStyleNone;
+  window.backgroundColor = skia::SkColorToSRGBNSColor(color);
+}
