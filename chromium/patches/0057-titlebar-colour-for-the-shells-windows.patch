+#ifndef CHROME_BROWSER_EXTENSIONS_API_FLECHA_PRIVATE_FLECHA_TITLEBAR_H_
+#define CHROME_BROWSER_EXTENSIONS_API_FLECHA_PRIVATE_FLECHA_TITLEBAR_H_
+
+#include "build/build_config.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/native_ui_types.h"
+
+// Gives a window with a system title bar (a popup, such as Settings) a title
+// bar of `color`, with no line under it, so that it reads as one surface with
+// a page of that colour (chrome.flechaPrivate.setTitlebarColor()). A no-op
+// off macOS.
+#if BUILDFLAG(IS_MAC)
+void SetFlechaTitlebarColor(gfx::NativeWindow window, SkColor color);
+#else
+inline void SetFlechaTitlebarColor(gfx::NativeWindow window, SkColor color) {}
+#endif
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_FLECHA_PRIVATE_FLECHA_TITLEBAR_H_
