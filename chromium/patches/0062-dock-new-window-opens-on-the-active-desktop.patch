 // Explicitly bring to the foreground when creating new windows from the dock.
 - (void)commandFromDock:(id)sender {
+  // Flecha: a new window opens on the desktop (Space) the Dock was used on.
+  // Activating Flecha first, with all its windows on other desktops, makes
+  // macOS switch to one of those, and the new window opens there. So the
+  // window is made first, as one that stays on the active desktop, and
+  // showing it brings Flecha to the foreground.
+  const NSInteger tag = [sender tag];
+  if (tag == IDC_NEW_WINDOW || tag == IDC_NEW_INCOGNITO_WINDOW) {
+    {
+      base::AutoReset<bool> opening(&FlechaFrameHost::OpeningOnActiveDesktop(),
+                                    true);
+      [self commandDispatch:sender];
+    }
+    [NSApp activateIgnoringOtherApps:YES];
+    return;
+  }
   [NSApp activateIgnoringOtherApps:YES];
   [self commandDispatch:sender];
 }
