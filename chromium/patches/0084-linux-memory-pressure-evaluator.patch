+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_MEMORY_PRESSURE_SYSTEM_MEMORY_PRESSURE_EVALUATOR_LINUX_H_
+#define COMPONENTS_MEMORY_PRESSURE_SYSTEM_MEMORY_PRESSURE_EVALUATOR_LINUX_H_
+
+#include <memory>
+#include <optional>
+#include <string_view>
+
+#include "base/feature_list.h"
+#include "base/files/file_path.h"
+#include "base/memory/memory_pressure_level.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "components/memory_pressure/system_memory_pressure_evaluator.h"
+
+namespace memory_pressure {
+
+BASE_DECLARE_FEATURE(kFlechaLinuxMemoryPressureEvaluator);
+
+class SystemMemoryPressureEvaluatorLinux final
+    : public SystemMemoryPressureEvaluator {
+ public:
+  SystemMemoryPressureEvaluatorLinux(std::unique_ptr<MemoryPressureVoter> voter,
+                                     base::FilePath proc_root);
+  ~SystemMemoryPressureEvaluatorLinux() override;
+
+  // Either proc file can supply a pressure signal on its own.
+  static std::optional<base::MemoryPressureLevel> ClassifySample(
+      std::string_view psi,
+      std::string_view meminfo);
+
+ private:
+  void Poll();
+  void OnSample(std::optional<base::MemoryPressureLevel> sample);
+
+  const base::FilePath proc_root_;
+  base::MemoryPressureLevel previous_sample_ = base::MEMORY_PRESSURE_LEVEL_NONE;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<SystemMemoryPressureEvaluatorLinux> weak_factory_{this};
+};
+
+}  // namespace memory_pressure
+
+#endif  // COMPONENTS_MEMORY_PRESSURE_SYSTEM_MEMORY_PRESSURE_EVALUATOR_LINUX_H_
diff --git a/components/memory_pressure/system_memory_pressure_evaluator_linux_unittest.cc b/components/memory_pressure/system_memory_pressure_evaluator_linux_unittest.cc
new file mode 100644
index 0000000..db94d0a
--- /dev/null
+++ b/components/memory_pressure/system_memory_pressure_evaluator_linux_unittest.cc
@@ -0,0 +1,108 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/memory_pressure/system_memory_pressure_evaluator_linux.h"
+
+#include <optional>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/test/bind.h"
+#include "base/test/scoped_feature_list.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "components/memory_pressure/multi_source_memory_pressure_monitor.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace memory_pressure {
+namespace {
+
+using Evaluator = SystemMemoryPressureEvaluatorLinux;
+using base::MEMORY_PRESSURE_LEVEL_CRITICAL;
+using base::MEMORY_PRESSURE_LEVEL_MODERATE;
+using base::MEMORY_PRESSURE_LEVEL_NONE;
+
+constexpr char kPlenty[] = "MemTotal: 4194304 kB\nMemAvailable: 204800 kB\n";
+constexpr char kLow[] = "MemAvailable:\t204799 kB\nMemTotal: 4194304 kB\n";
+constexpr char kExhausted[] = "MemTotal: 4194304 kB\nMemAvailable: 0 kB\n";
+
+TEST(SystemMemoryPressureEvaluatorLinuxTest, KernelStallAverages) {
+  EXPECT_EQ(
+      Evaluator::ClassifySample(
+          "full avg10=6.99 avg60=99.0\nsome total=123 avg10=9.99\n", kPlenty),
+      MEMORY_PRESSURE_LEVEL_NONE);
+  EXPECT_EQ(
+      Evaluator::ClassifySample("some avg10=10.00\nfull avg10=0.00\n", ""),
+      MEMORY_PRESSURE_LEVEL_MODERATE);
+  EXPECT_EQ(
+      Evaluator::ClassifySample("full avg10=7.00\nsome avg10=10.00\n", kPlenty),
+      MEMORY_PRESSURE_LEVEL_CRITICAL);
+}
+
+TEST(SystemMemoryPressureEvaluatorLinuxTest, AvailableMemoryFallback) {
+  EXPECT_EQ(Evaluator::ClassifySample("", kPlenty), MEMORY_PRESSURE_LEVEL_NONE);
+  EXPECT_EQ(Evaluator::ClassifySample("", kLow),
+            MEMORY_PRESSURE_LEVEL_MODERATE);
+  EXPECT_EQ(Evaluator::ClassifySample("some avg10=99\nfull avg10=bad", kLow),
+            MEMORY_PRESSURE_LEVEL_MODERATE);
+  EXPECT_EQ(Evaluator::ClassifySample("some avg10=0\nfull avg10=0", kExhausted),
+            MEMORY_PRESSURE_LEVEL_CRITICAL);
+}
+
+TEST(SystemMemoryPressureEvaluatorLinuxTest, RejectsUnusableSamples) {
+  EXPECT_EQ(Evaluator::ClassifySample("full avg10=100", "MemTotal: 1024 kB"),
+            std::nullopt);
+  EXPECT_EQ(Evaluator::ClassifySample("some avg10=nan\nfull avg10=101",
+                                      "MemTotal: 1024 kB\nMemAvailable: 0 MB"),
+            std::nullopt);
+  EXPECT_EQ(Evaluator::ClassifySample("", "MemTotal: 1 kB\nMemAvailable: 2 kB"),
+            std::nullopt);
+}
+
+TEST(SystemMemoryPressureEvaluatorLinuxTest, VotesOnEscalationAndRecovery) {
+  base::test::TaskEnvironment tasks(
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME);
+  base::ScopedTempDir proc;
+  ASSERT_TRUE(proc.CreateUniqueTempDir());
+  const auto meminfo = proc.GetPath().AppendASCII("meminfo");
+  ASSERT_TRUE(base::WriteFile(meminfo, kLow));
+
+  MultiSourceMemoryPressureMonitor monitor;
+  std::vector<base::MemoryPressureLevel> levels;
+  monitor.SetDispatchCallbackForTesting(base::BindLambdaForTesting(
+      [&](base::MemoryPressureLevel level) { levels.push_back(level); }));
+  Evaluator evaluator(monitor.CreateVoter(), proc.GetPath());
+  tasks.RunUntilIdle();
+  EXPECT_EQ(evaluator.current_vote(), MEMORY_PRESSURE_LEVEL_MODERATE);
+  ASSERT_TRUE(base::WriteFile(meminfo, kExhausted));
+  tasks.FastForwardBy(base::Seconds(5));
+  EXPECT_EQ(evaluator.current_vote(), MEMORY_PRESSURE_LEVEL_CRITICAL);
+  ASSERT_TRUE(base::WriteFile(meminfo, kPlenty));
+  tasks.FastForwardBy(base::Seconds(5));
+  EXPECT_EQ(evaluator.current_vote(), MEMORY_PRESSURE_LEVEL_CRITICAL);
+  ASSERT_TRUE(base::WriteFile(meminfo, kLow));
+  tasks.FastForwardBy(base::Seconds(5));
+  EXPECT_EQ(evaluator.current_vote(), MEMORY_PRESSURE_LEVEL_MODERATE);
+  // Losing both sources must stop periodic notifications of stale pressure.
+  ASSERT_TRUE(base::WriteFile(meminfo, ""));
+  tasks.FastForwardBy(base::Seconds(5));
+  ASSERT_FALSE(levels.empty());
+  EXPECT_EQ(levels.back(), MEMORY_PRESSURE_LEVEL_NONE);
+}
+
+TEST(SystemMemoryPressureEvaluatorLinuxTest, FactoryHonorsFeature) {
+  base::test::TaskEnvironment tasks;
+  MultiSourceMemoryPressureMonitor monitor;
+  for (bool enabled : {false, true}) {
+    base::test::ScopedFeatureList feature;
+    feature.InitWithFeatureState(kFlechaLinuxMemoryPressureEvaluator, enabled);
+    auto evaluator = Evaluator::CreateDefaultSystemEvaluator(&monitor);
+    EXPECT_EQ(evaluator != nullptr, enabled);
+  }
+  tasks.RunUntilIdle();
+}
+
+}  // namespace
+}  // namespace memory_pressure
