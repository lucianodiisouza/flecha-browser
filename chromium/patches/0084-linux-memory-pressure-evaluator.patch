diff --git a/components/memory_pressure/system_memory_pressure_evaluator_linux.cc b/components/memory_pressure/system_memory_pressure_evaluator_linux.cc
new file mode 100644
index 0000000..527a13a
--- /dev/null
+++ b/components/memory_pressure/system_memory_pressure_evaluator_linux.cc
@@ -0,0 +1,152 @@
+// Copyright 2026 The Flecha Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/memory_pressure/system_memory_pressure_evaluator_linux.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <utility>
+
+#include "base/byte_size.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_tokenizer.h"
+#include "base/strings/string_util.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+
+namespace memory_pressure {
+
+BASE_FEATURE(kFlechaLinuxMemoryPressureEvaluator,
+             base::FEATURE_ENABLED_BY_DEFAULT);
+
+namespace {
+
+constexpr auto kPollInterval = base::Seconds(5);
+// FlechaLowRamPolicy's default discard threshold and Chromium Cast's
+// absolute critical floor, both expressed here in /proc/meminfo's KiB.
+constexpr uint64_t kModerateAvailableKiB = base::MiB(200).InKiB();
+constexpr uint64_t kCriticalAvailableKiB = base::MiB(20).InKiB();
+// Stall fractions from AOSP lmkd's PSI medium/critical triggers (100 ms
+// partial / 70 ms full per second), applied to the kernel's 10-second mean.
+constexpr double kModerateSomePercent = 10;
+constexpr double kCriticalFullPercent = 7;
+
+std::string_view RowFields(std::string_view contents, std::string_view key) {
+  base::StringViewTokenizer lines(contents, "\n");
+  while (auto line = lines.GetNextTokenView()) {
+    auto row = base::SplitStringOnce(*line, " \t");
+    if (row && row->first == key) {
+      return row->second;
+    }
+  }
+  return {};
+}
+
+std::optional<double> Avg10(std::string_view row) {
+  base::StringViewTokenizer fields(row, " \t");
+  while (auto field = fields.GetNextTokenView()) {
+    constexpr std::string_view kPrefix = "avg10=";
+    if (field->starts_with(kPrefix)) {
+      double percent;
+      if (base::StringToDouble(field->substr(kPrefix.size()), &percent) &&
+          percent >= 0 && percent <= 100) {
+        return percent;
+      }
+      break;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<uint64_t> ParseKiB(std::string_view row) {
+  base::StringViewTokenizer fields(row, " \t");
+  auto number = fields.GetNextTokenView();
+  uint64_t kib;
+  if (number && base::StringToUint64(*number, &kib) &&
+      fields.GetNextTokenView() == "kB" && !fields.GetNextTokenView()) {
+    return kib;
+  }
+  return std::nullopt;
+}
+
+std::optional<base::MemoryPressureLevel> ReadSample(base::FilePath proc_root) {
+  std::string psi;
+  std::string meminfo;
+  if (!base::ReadFileToString(proc_root.AppendASCII("pressure/memory"), &psi)) {
+    psi.clear();
+  }
+  if (!base::ReadFileToString(proc_root.AppendASCII("meminfo"), &meminfo)) {
+    meminfo.clear();
+  }
+  return SystemMemoryPressureEvaluatorLinux::ClassifySample(psi, meminfo);
+}
+
+}  // namespace
+
+SystemMemoryPressureEvaluatorLinux::SystemMemoryPressureEvaluatorLinux(
+    std::unique_ptr<MemoryPressureVoter> voter,
+    base::FilePath proc_root)
+    : SystemMemoryPressureEvaluator(std::move(voter)),
+      proc_root_(std::move(proc_root)) {
+  Poll();
+}
+
+SystemMemoryPressureEvaluatorLinux::~SystemMemoryPressureEvaluatorLinux() =
+    default;
+
+// static
+std::optional<base::MemoryPressureLevel>
+SystemMemoryPressureEvaluatorLinux::ClassifySample(std::string_view psi,
+                                                   std::string_view meminfo) {
+  const auto some = Avg10(RowFields(psi, "some"));
+  const auto full = Avg10(RowFields(psi, "full"));
+  const auto total = ParseKiB(RowFields(meminfo, "MemTotal:"));
+  const auto available = ParseKiB(RowFields(meminfo, "MemAvailable:"));
+  const bool has_psi = some && full;
+  const bool has_memory =
+      total && *total > 0 && available && *available <= *total;
+  if (!has_psi && !has_memory) {
+    return std::nullopt;
+  }
+  if ((has_psi && *full >= kCriticalFullPercent) ||
+      (has_memory && *available < kCriticalAvailableKiB)) {
+    return base::MEMORY_PRESSURE_LEVEL_CRITICAL;
+  }
+  if ((has_psi && *some >= kModerateSomePercent) ||
+      (has_memory && *available < kModerateAvailableKiB)) {
+    return base::MEMORY_PRESSURE_LEVEL_MODERATE;
+  }
+  return base::MEMORY_PRESSURE_LEVEL_NONE;
+}
+
+void SystemMemoryPressureEvaluatorLinux::Poll() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadSample, proc_root_),
+      base::BindOnce(&SystemMemoryPressureEvaluatorLinux::OnSample,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SystemMemoryPressureEvaluatorLinux::OnSample(
+    std::optional<base::MemoryPressureLevel> sample) {
+  timer_.Start(FROM_HERE, kPollInterval, this,
+               &SystemMemoryPressureEvaluatorLinux::Poll);
+  // Escalate immediately. Require two lower readings to recover. If both
+  // files disappear, release our vote so stale pressure cannot re-notify.
+  const auto level = sample ? std::max(*sample, previous_sample_)
+                            : base::MEMORY_PRESSURE_LEVEL_NONE;
+  previous_sample_ = sample.value_or(base::MEMORY_PRESSURE_LEVEL_NONE);
+  if (level != current_vote()) {
+    SetCurrentVote(level);
+    SendCurrentVote();
+  }
+}
+
+}  // namespace memory_pressure
